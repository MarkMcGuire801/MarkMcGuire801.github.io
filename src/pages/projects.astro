---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();

const statusStyle: Record<string, string> = {
  Complete: "color: var(--slate); border-color: var(--slate);",
  "In Progress": "color: var(--text-muted); border-color: var(--border-strong);",
  Planned: "color: var(--text-muted); border-color: var(--border-strong);",
};
---

<Base title="Projects">
  <section class="reveal is-visible mx-auto max-w-5xl px-5 pt-16 sm:px-8 sm:pt-20">
    <p class="ink-eyebrow" style="opacity:1;">Selected work</p>
    <h1 class="text-4xl sm:text-5xl">Projects</h1>
    <p class="mt-4 max-w-xl" style="color: var(--text-muted);">
      Hands-on builds spanning governance, automation, and network engineering.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter projects by tag">
      <button class="filter-chip is-on" data-tag="all" type="button">All</button>
      {allTags.map((tag) => (
        <button class="filter-chip" data-tag={tag} type="button">{tag}</button>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pt-8 sm:px-8">
    <div id="project-grid" class="grid gap-5 sm:grid-cols-2">
      {
        projects.map((p) => (
          <article
            class="project-item card flex flex-col p-6"
            data-tags={p.data.tags.join(",")}
          >
            <div class="mb-3 flex items-center gap-2">
              <span class="pill" style={statusStyle[p.data.status]}>{p.data.status}</span>
            </div>
            <h2 class="text-xl" style="font-family: var(--font-display); font-weight: 500;">
              {p.data.hasWriteup ? (
                <a href={`/projects/${p.id}`} style="color: var(--text);">{p.data.title}</a>
              ) : (
                p.data.title
              )}
            </h2>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {p.data.tags.map((t) => (
                <span class="text-xs mono" style="color: var(--slate);">#{t.replace(/\s+/g, "")}</span>
              ))}
            </div>
            <p class="mt-4 flex-1 text-sm" style="color: var(--text-muted);">{p.data.summary}</p>
            {p.data.externalNote && (
              <p class="mt-3 text-xs italic" style="color: var(--text-muted);">{p.data.externalNote}</p>
            )}
            {p.data.hasWriteup && (
              <a href={`/projects/${p.id}`} class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium" style="color: var(--accent);">
                Read writeup
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            )}
          </article>
        ))
      }
    </div>
    <p id="empty-msg" class="hidden py-12 text-center text-sm" style="color: var(--text-muted);">
      No projects with that tag yet.
    </p>
  </section>
</Base>

<style>
  .filter-chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .filter-chip:hover { border-color: var(--slate); color: var(--text); }
  .filter-chip.is-on { background: var(--accent); color: var(--cream); border-color: var(--accent); }
</style>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll(".filter-chip");
    var items = document.querySelectorAll(".project-item");
    var empty = document.getElementById("empty-msg");
    chips.forEach(function (chip) {
      chip.addEventListener("click", function () {
        chips.forEach(function (c) { c.classList.remove("is-on"); });
        chip.classList.add("is-on");
        var tag = chip.getAttribute("data-tag");
        var shown = 0;
        items.forEach(function (item) {
          var tags = (item.getAttribute("data-tags") || "").split(",");
          var show = tag === "all" || tags.indexOf(tag) !== -1;
          item.style.display = show ? "" : "none";
          if (show) shown++;
        });
        empty.classList.toggle("hidden", shown !== 0);
      });
    });
  })();
</script>
