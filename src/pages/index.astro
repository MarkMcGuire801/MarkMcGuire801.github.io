---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { site } from "../data/site";
import { skills } from "../data/skills";
---

<Base>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-5 pt-16 pb-10 sm:px-8 sm:pt-24">
    <div class="grid items-center gap-10 md:grid-cols-[1.4fr_1fr]">
      <div class="reveal is-visible">
        <p class="ink-eyebrow" style="opacity:1;">{site.location}</p>
        <h1 class="text-4xl leading-[1.05] sm:text-6xl">{site.name}</h1>
        <p class="mt-4 text-lg sm:text-xl" style="color: var(--text-muted);">
          {site.title}
        </p>
        <p class="mt-6 max-w-xl text-[1.05rem]">
          Building robust systems with a security-first mindset.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={site.resume}
            target="_blank"
            rel="noopener"
            class="rounded-lg px-5 py-2.5 text-sm font-medium transition-colors"
            style="background: var(--accent); color: var(--cream);"
          >
            View résumé
          </a>
          <a
            href="/projects"
            class="rounded-lg px-5 py-2.5 text-sm font-medium transition-colors"
            style="border: 1px solid var(--border-strong); color: var(--text);"
          >
            See projects
          </a>
        </div>
      </div>

      <!-- Headshot slot -->
      <div class="reveal is-visible flex justify-center md:justify-end">
        <div
          class="relative aspect-[4/5] w-full max-w-[280px] overflow-hidden rounded-2xl"
          style="background: var(--bg-raised); border: 1px solid var(--border);"
        >
          <!-- Replace this block with: <img src="/assets/headshot.jpg" alt="Mark McGuire" class="h-full w-full object-cover" /> -->
          <div class="flex h-full w-full flex-col items-center justify-center gap-2" style="color: var(--text-muted);">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <circle cx="12" cy="9" r="3.2"></circle>
              <path d="M5.5 19a6.5 6.5 0 0 1 13 0" stroke-linecap="round"></path>
            </svg>
            <span class="text-xs mono">Headshot</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <Section eyebrow="01 — About" title="Background" class="pt-14">
    <div class="max-w-2xl space-y-4 text-[1.05rem]">
      <p>
        I'm a Jr. IT Systems Administrator based in Tucson, AZ, with a passion for building and
        maintaining reliable infrastructure. I currently work for a charter school, keeping
        systems running smoothly and securely, and I'm genuinely grateful for the opportunity
        to support the education of the underprivileged and underserved youth that my
        organization focuses on.
      </p>
      <p>
        Taking initiative in our environment's cybersecurity landscape was one of the most
        impactful decisions of my career; every task I tackled in that space deepened my
        interest in the field and set me on the path I'm on today.
      </p>
      <p>
        When I'm not managing systems, I'm sharpening my security skills through hands-on labs,
        studying for certifications, and exploring the tools and techniques that define modern
        cybersecurity practice. I believe the best defense comes from truly understanding how
        systems work from the ground up.
      </p>
    </div>
  </Section>

  <!-- Capabilities -->
  <Section eyebrow="02 — Capabilities" title="Skills & tooling" class="pt-20">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        skills.map((group) => (
          <div class="card p-5">
            <div class="mb-3 flex items-baseline justify-between gap-3">
              <h3 class="text-base" style="font-family: var(--font-display); font-weight: 500;">
                {group.category}
              </h3>
              {group.note && <span class="pill shrink-0">{group.note}</span>}
            </div>
            <div class="space-y-3">
              {group.bands.map((band) => (
                <div>
                  {band.label && (
                    <p class="mb-1.5 text-xs mono" style="color: var(--text-muted); letter-spacing: 0.04em;">
                      {band.label}
                    </p>
                  )}
                  <div class="flex flex-wrap gap-1.5">
                    {band.items.map((item) => (
                      <span class="rounded-md px-2 py-0.5 text-[0.8rem]" style="background: var(--code-bg); color: var(--text);">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>
</Base>
