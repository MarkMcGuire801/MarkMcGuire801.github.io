---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort((a, b) => {
  const da = a.data.date ? a.data.date.getTime() : 0;
  const db = b.data.date ? b.data.date.getTime() : 0;
  return db - da;
});
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title="Blog">
  <section class="reveal is-visible mx-auto max-w-5xl px-5 pt-16 sm:px-8 sm:pt-20">
    <p class="ink-eyebrow" style="opacity:1;">Writing</p>
    <h1 class="text-4xl sm:text-5xl">Blog</h1>
    <p class="mt-4 max-w-xl" style="color: var(--text-muted);">
      Working through security and cryptography concepts by explaining them from the ground up.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter posts by tag">
      <button class="filter-chip is-on" data-tag="all" type="button">All</button>
      {allTags.map((tag) => (
        <button class="filter-chip" data-tag={tag} type="button">{tag}</button>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pt-8 sm:px-8">
    <div id="post-list" class="flex flex-col gap-4">
      {
        posts.map((post) => (
          <article class="post-item card p-6" data-tags={post.data.tags.join(",")}>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
              <div class="min-w-0">
                <h2 class="text-xl" style="font-family: var(--font-display); font-weight: 500;">
                  {post.data.draft ? (
                    <span style="color: var(--text);">{post.data.title}</span>
                  ) : (
                    <a href={`/blog/${post.id}`} style="color: var(--text);">{post.data.title}</a>
                  )}
                </h2>
                <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs mono" style="color: var(--text-muted);">
                  <span>{post.data.dateLabel}</span>
                  <span aria-hidden="true">·</span>
                  {post.data.tags.map((t) => (<span style="color: var(--slate);">#{t}</span>))}
                </div>
              </div>
              {post.data.draft && <span class="pill shrink-0">Coming soon</span>}
            </div>
            <p class="mt-4 text-sm" style="color: var(--text-muted);">{post.data.summary}</p>
            {!post.data.draft && (
              <a href={`/blog/${post.id}`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium" style="color: var(--accent);">
                Read post
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            )}
          </article>
        ))
      }
    </div>
    <p id="empty-msg" class="hidden py-12 text-center text-sm" style="color: var(--text-muted);">
      No posts with that tag yet.
    </p>
  </section>
</Base>

<style>
  .filter-chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .filter-chip:hover { border-color: var(--slate); color: var(--text); }
  .filter-chip.is-on { background: var(--accent); color: var(--cream); border-color: var(--accent); }
</style>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll(".filter-chip");
    var items = document.querySelectorAll(".post-item");
    var empty = document.getElementById("empty-msg");
    chips.forEach(function (chip) {
      chip.addEventListener("click", function () {
        chips.forEach(function (c) { c.classList.remove("is-on"); });
        chip.classList.add("is-on");
        var tag = chip.getAttribute("data-tag");
        var shown = 0;
        items.forEach(function (item) {
          var tags = (item.getAttribute("data-tags") || "").split(",");
          var show = tag === "all" || tags.indexOf(tag) !== -1;
          item.style.display = show ? "" : "none";
          if (show) shown++;
        });
        empty.classList.toggle("hidden", shown !== 0);
      });
    });
  })();
</script>
